+    // Buffers are reserved with room to spare: the size a copy needs depends on the rows it covers and changes
+    // from frame to frame, and an exact size made a buffer be recreated whenever the next copy was slightly bigger.
+    static uint32_t reservedBufferSize(uint32_t bufferSize) {
+        uint32_t size = 0x1000;
+        while (size < bufferSize) {
+            size <<= 1;
+        }
+
+        return size;
+    }
